<Window x:Class="AllyConsole.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ally Console"
        Width="440"
        Height="680"
        MinWidth="320"
        MinHeight="420"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="Manual"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Stylus.IsPressAndHoldEnabled="False"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing">
  <Border Margin="10" CornerRadius="18" Background="#12151C" BorderBrush="#2A3142" BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.5" Color="#000000"/>
    </Border.Effect>
    <Grid Margin="16">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Grid>
        <StackPanel Margin="0,0,100,0">
          <TextBlock x:Name="TitleText" Text="Ally Console" FontSize="24" FontWeight="SemiBold" Foreground="#F4F6FB"/>
          <TextBlock x:Name="SubtitleText" Margin="0,4,0,0" FontSize="14" Foreground="#A8B0C0" TextWrapping="Wrap"/>
        </StackPanel>
        <Button x:Name="HeaderButton" Content="Close" HorizontalAlignment="Right" VerticalAlignment="Top"
                Style="{StaticResource GhostButton}" Click="HeaderButton_Click"/>
      </Grid>
      <Border x:Name="DevBanner" Grid.Row="1" Margin="0,12,0,0" Padding="12,8" CornerRadius="10"
              Background="#3A2E1E" Visibility="Collapsed">
        <TextBlock TextWrapping="Wrap" Foreground="#F0C48A" FontSize="14"
                   Text="Development mode. Battery, volume, GPU, brightness, and displays on this screen are samples, not this PC."/>
      </Border>
      <TextBlock x:Name="HotkeyText" Grid.Row="2" Margin="0,10,0,0" FontSize="14" Foreground="#E07A7A" TextWrapping="Wrap" Visibility="Collapsed"/>
      <ScrollViewer x:Name="Scroller" Grid.Row="3" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="Rows"/>
      </ScrollViewer>
      <StackPanel Grid.Row="4" Margin="0,10,0,0">
        <TextBlock x:Name="ErrorText" FontSize="14" Foreground="#E07A7A" TextWrapping="Wrap" Margin="0,0,0,6"/>
        <TextBlock x:Name="HintText" FontSize="13" Foreground="#7E8798" TextWrapping="Wrap"
                   Text="Controller, arrow keys, touch, or mouse. A or Enter selects. B or Esc goes back."/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
