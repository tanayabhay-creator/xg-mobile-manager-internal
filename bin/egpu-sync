#!/bin/bash
VENDOR=$1
OS_TYPE=$2
PRIMARY_USER=$(ps -o user= -C steam | head -n 1 | xargs)
[ -z "$PRIMARY_USER" ] && PRIMARY_USER="deck"

# Check if the ASUS WMI interface says the eGPU is actually connected
ACTIVE=$(cat /sys/devices/platform/asus-nb-wmi/egpu_enable 2>/dev/null || echo "0")

if [ "$ACTIVE" -eq 0 ]; then
    echo "Failsafe triggered: XG Mobile is not physically connected."
    echo "Disabling sync service to clean up the environment."
    systemctl disable xgmobile-boot-sync.service 2>/dev/null
    
    # Optionally: Clean up the kwin env file here just to be safe
    rm -f /home/deck/.config/plasma-workspace/env/xgmobile-nvidia-kwin.sh
    
    exit 0
fi

echo "--- Boot DRM Sync Started at $(date) ---"

# Graceful exit for AMD users
if [ "$VENDOR" == "amd" ]; then
  echo "AMD eGPU detected. Native amdgpu drivers do not require DRM environment sync."
  echo "Sync complete (Skipped cleanly)."
  exit 0
fi

if [[ "$OS_TYPE" == "steamos" || "$OS_TYPE" == *"cachyos"* ]]; then
  # nvidia-drm registers the XG Mobile card a fraction of a second after this
  # service starts. Wait for that card before deciding the dock is missing.
  nvidia_drm_present() {
    local card
    for card in /sys/class/drm/card*; do
      case "$(basename "$card")" in
        card[0-9]|card[0-9][0-9]) ;;
        *) continue ;;
      esac
      [ "$(cat "$card/device/vendor" 2>/dev/null)" = "0x10de" ] && return 0
    done
    return 1
  }
  if nvidia_drm_present; then
    echo "eGPU DRM card already present."
  else
    EGPU_PCI=""
    for dev in /sys/bus/pci/devices/*; do
      [ "$(cat "$dev/vendor" 2>/dev/null)" = "0x10de" ] || continue
      class=$(cat "$dev/class" 2>/dev/null)
      case "$class" in
        0x03*) EGPU_PCI="$dev"; break ;;
      esac
    done
    if [ -n "$EGPU_PCI" ] && udevadm wait --help >/dev/null 2>&1; then
      udevadm wait --timeout=10 "/dev/dri/by-path/pci-$(basename "$EGPU_PCI")-card" >/dev/null 2>&1 || true
    else
      WAITED=0
      while [ "$WAITED" -lt 40 ] && ! nvidia_drm_present; do
        sleep 0.25
        WAITED=$((WAITED + 1))
      done
    fi
    if nvidia_drm_present; then
      echo "eGPU DRM card appeared."
    else
      echo "eGPU DRM card did not appear within 10s."
    fi
  fi

  # Foolproof detection of exact DRM nodes based on hardware vendor ID
  for card in /sys/class/drm/card*; do
    case "$(basename "$card")" in
      card[0-9]|card[0-9][0-9]) ;;
      *) continue ;;
    esac
    HW_VENDOR=$(cat $card/device/vendor 2>/dev/null)
    if [ "$HW_VENDOR" == "0x10de" ]; then # NVIDIA ID
      EGPU_CARD="/dev/dri/$(basename $card)"
    elif [ "$HW_VENDOR" == "0x1002" ] || [ "$HW_VENDOR" == "0x1022" ]; then # AMD IDs
      IGPU_CARD="/dev/dri/$(basename $card)"
    fi
  done

  if [ -z "$EGPU_CARD" ] || [ -z "$IGPU_CARD" ]; then
    echo "WARNING: the eGPU DRM card did not appear within 10s, or the handheld GPU is missing. Sync aborted."
    exit 1
  fi

  SCRIPT_DIR=$(dirname "$(readlink -f "$0")")
  PLUGIN_DIR=$(readlink -f "$SCRIPT_DIR/..")
  HOMEBREW_DIR=$(readlink -f "$PLUGIN_DIR/../..")
  DATA_DIR="$HOMEBREW_DIR/data/xgmobile-manager"
  DISPLAY_TARGET="external"
  if [ -f "$DATA_DIR/display_target" ]; then
    DISPLAY_TARGET=$(tr -d '[:space:]' < "$DATA_DIR/display_target")
  fi
  if [ "$DISPLAY_TARGET" = "internal" ]; then
    DRM_ORDER="$IGPU_CARD:$EGPU_CARD"
  else
    DRM_ORDER="$EGPU_CARD:$IGPU_CARD"
  fi
  echo "Boot sync display target: $DISPLAY_TARGET ($DRM_ORDER)"

  # 1. Update the System-Wide Environment
  steamos-readonly disable 2>/dev/null || true
  sed -i 's|WLR_DRM_DEVICES=.*|WLR_DRM_DEVICES='$DRM_ORDER'|' /etc/environment
  steamos-readonly enable 2>/dev/null || true

  # 2. Update the Isolated Plasma Environment
  PLASMA_ENV_DIR="/home/$PRIMARY_USER/.config/plasma-workspace/env"
  if [ "$DISPLAY_TARGET" = "internal" ]; then
    sudo -u $PRIMARY_USER bash -c "cat > '$PLASMA_ENV_DIR/xgmobile-nvidia-kwin.sh' << EOF
#!/bin/bash
export KWIN_DRM_DEVICES=$DRM_ORDER
EOF"
  else
    sudo -u $PRIMARY_USER bash -c "cat > '$PLASMA_ENV_DIR/xgmobile-nvidia-kwin.sh' << EOF
#!/bin/bash
export KWIN_DRM_DEVICES=$DRM_ORDER
export GBM_BACKEND=nvidia-drm
export __GLX_VENDOR_LIBRARY_NAME=nvidia
EOF"
  fi
  echo "SteamOS/CachyOS specific DRM environment sync complete."
else
  echo "Bazzite OS detected. Skipping."
fi

echo "Sync complete. Ready for Desktop Mode."
