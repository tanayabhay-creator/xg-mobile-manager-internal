#!/bin/bash
VENDOR=$1 # Capture 'nvidia' or 'amd' from the plugin
OS_TYPE=$2
LOG_DIR=$3
DATA_DIR=$4
SUPERGFX_TRIG=0
#PRIMARY_USER=$(echo "$LOG_DIR" | cut -d/ -f3)
PRIMARY_USER=$(ps -o user= -C steam | head -n 1 | xargs)
[ -z "$PRIMARY_USER" ] && PRIMARY_USER="deck"
mkdir -p "$DATA_DIR/configs"
exec > "$LOG_DIR/xgmobile_manager_eject_${VENDOR}.log" 2>&1

echo "--- XG Mobile Eject ($VENDOR) Started at $(date) ---"

if systemctl is-active --quiet supergfxd.service; then 
  echo "Supergfxd Detected. Stopping supergfxd to avoid panic during switch..."
  systemctl stop supergfxd.service 2>/dev/null || true
  SUPERGFX_TRIG=1
fi

# SteamOS desktop is SDDM. Bazzite Game Mode is not: stopping SDDM there
# opens the desktop login and the next boot comes up signed out.
if [[ "$OS_TYPE" == *"bazzite"* ]]; then
  echo "Leaving Bazzite Game Mode running until the dock is off."
else
  echo "Stopping SDDM..."
  systemctl stop sddm
fi

queue_gamescope_restart() {
  local uid unit
  if ! id "$PRIMARY_USER" >/dev/null 2>&1; then
    echo "No logged-in user. Game Mode was not restarted."
    return
  fi
  uid=$(id -u "$PRIMARY_USER")
  unit=$(sudo -u "$PRIMARY_USER" XDG_RUNTIME_DIR=/run/user/$uid DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$uid/bus systemctl --user list-units --type=service --all --no-legend 'gamescope-session-plus@*' 2>/dev/null | awk 'NR==1 { print $1 }')
  if [ -z "$unit" ]; then
    echo "gamescope-session-plus is not running."
    return
  fi
  echo "Game Mode will restart on $unit."
  systemd-run --collect /bin/bash -c "sleep 2; sudo -u '$PRIMARY_USER' XDG_RUNTIME_DIR=/run/user/$uid DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$uid/bus systemctl --user restart '$unit'" >/dev/null 2>&1 || true
}

if [[ "$OS_TYPE" == "steamos" || "$OS_TYPE" == *"cachyos"* ]]; then
  echo "Sanitizing /etc/environment..."
  sed -i '/MESA_VK_DEVICE_SELECT/d' /etc/environment
  sed -i '/VK_ICD_FILENAMES/d' /etc/environment
  sed -i '/WLR_DRM_DEVICES/d' /etc/environment
  #sed -i '/KWIN_DRM_DEVICES/d' /etc/environment
  #sed -i '/GBM_BACKEND/d' /etc/environment
  #sed -i '/__GLX_VENDOR_LIBRARY_NAME/d' /etc/environment
  sed -i '/VK_LOADER_LAYERS_DISABLE/d' /etc/environment
  sed -i '/GAMESCOPE_DISABLE_VK_KHR_PRESENT_WAIT/d' /etc/environment
  sed -i '/DXVK_FILTER_DEVICE_NAME/d' /etc/environment
  sed -i '/VKD3D_FILTER_DEVICE_NAME/d' /etc/environment
  sed -i '/VULKAN_ADAPTER/d' /etc/environment
  sed -i '/OUTPUT_CONNECTOR/d' /etc/environment
  sed -i '/PROTON_ENABLE_NVAPI/d' /etc/environment
  systemctl unset-environment DXVK_FILTER_DEVICE_NAME VKD3D_FILTER_DEVICE_NAME VULKAN_ADAPTER OUTPUT_CONNECTOR PROTON_ENABLE_NVAPI || true

  if [ "$VENDOR" == "nvidia" ]; then
    # De-Fanging Configs
    echo "De-fanging NVIDIA configs to protect AMD Handheld Mode..."
    steamos-readonly disable
    mkdir -p $DATA_DIR/configs_backup
    mv /usr/share/glvnd/egl_vendor.d/*nvidia* $DATA_DIR/configs_backup/ 2>/dev/null || true
    mv /usr/share/vulkan/implicit_layer.d/*nvidia* $DATA_DIR/configs_backup/ 2>/dev/null || true
    mv /usr/share/vulkan/explicit_layer.d/*nvidia* $DATA_DIR/configs_backup/ 2>/dev/null || true
    mv /usr/share/vulkan/icd.d/*nvidia* $DATA_DIR/configs_backup/ 2>/dev/null || true
    mv /usr/share/X11/xorg.conf.d/10-nvidia* $DATA_DIR/configs_backup/ 2>/dev/null || true
    steamos-readonly enable
  
    # Environment Cleanup (System-Wide)
    # We unset the exact variables we set in the enable script
    echo "Removing environment variables from volitile memory..."
    systemctl unset-environment MESA_VK_DEVICE_SELECT
    systemctl unset-environment VK_ICD_FILENAMES
    systemctl unset-environment WLR_DRM_DEVICES
    #systemctl unset-environment KWIN_DRM_DEVICES
    #systemctl unset-environment GBM_BACKEND
    #systemctl unset-environment __GLX_VENDOR_LIBRARY_NAME
    systemctl unset-environment VK_LOADER_LAYERS_DISABLE
    systemctl unset-environment GAMESCOPE_DISABLE_VK_KHR_PRESENT_WAIT

    # Environment Cleanup (User-Session)
    # Mirroring the Enable script's use of the deck user's session bus
    USER_UID=$(id -u $PRIMARY_USER)
    export DECK_BUS="XDG_RUNTIME_DIR=/run/user/$USER_UID"
    sudo -u $PRIMARY_USER $DECK_BUS systemctl --user unset-environment MESA_VK_DEVICE_SELECT
    sudo -u $PRIMARY_USER $DECK_BUS systemctl --user unset-environment VK_ICD_FILENAMES
    sudo -u $PRIMARY_USER $DECK_BUS systemctl --user unset-environment WLR_DRM_DEVICES
    sudo -u $PRIMARY_USER $DECK_BUS systemctl --user unset-environment DXVK_FILTER_DEVICE_NAME
    sudo -u $PRIMARY_USER $DECK_BUS systemctl --user unset-environment VKD3D_FILTER_DEVICE_NAME
    sudo -u $PRIMARY_USER $DECK_BUS systemctl --user unset-environment VULKAN_ADAPTER
    sudo -u $PRIMARY_USER $DECK_BUS systemctl --user unset-environment OUTPUT_CONNECTOR
    sudo -u $PRIMARY_USER $DECK_BUS systemctl --user unset-environment PROTON_ENABLE_NVAPI
    #sudo -u $PRIMARY_USER $DECK_BUS systemctl --user unset-environment KWIN_DRM_DEVICES
    #sudo -u $PRIMARY_USER $DECK_BUS systemctl --user unset-environment GBM_BACKEND
    #sudo -u $PRIMARY_USER $DECK_BUS systemctl --user unset-environment __GLX_VENDOR_LIBRARY_NAME

    echo "Removing isolated KDE Plasma environment config..."
    rm -f "/home/$PRIMARY_USER/.config/plasma-workspace/env/xgmobile-kwin.sh"
    rm -f "/home/$PRIMARY_USER/.config/plasma-workspace/env/xgmobile-nvidia-kwin.sh"

    # DISK CLEANUP
    echo "Removing environment variables from disk..."
    rm -f /etc/modprobe.d/nvidia-egpu.conf
 
    # Driver Purge
    # We kill any processes still holding the GPU and unload the modules
    echo "Stopping NVIDIA power services..."
    systemctl stop nvidia-powerd nvidia-persistenced 2>/dev/null || true
    systemctl disable xgmobile-boot-sync.service 2>/dev/null
    
    echo "Force killing any lingering GPU processes and stopping NVIDIA services..."
    fuser -kv /dev/nvidia* >/dev/null 2>&1
    modprobe -r nvidia_drm || true
    modprobe -r nvidia_modeset || true
    modprobe -r nvidia_uvm || true
    modprobe -r nvidia || true
  elif [ "$VENDOR" == "amd" ]; then
    echo "AMD Vendor detected. Removing injected variables..."
    echo "Removing environment variables from volitile memory..."
    systemctl unset-environment WLR_DRM_DEVICES
    USER_UID=$(id -u $PRIMARY_USER)
    export DECK_BUS="XDG_RUNTIME_DIR=/run/user/$USER_UID"
    sudo -u $PRIMARY_USER $DECK_BUS systemctl --user unset-environment WLR_DRM_DEVICES
    sudo -u $PRIMARY_USER $DECK_BUS systemctl --user unset-environment DXVK_FILTER_DEVICE_NAME
    sudo -u $PRIMARY_USER $DECK_BUS systemctl --user unset-environment VKD3D_FILTER_DEVICE_NAME
    sudo -u $PRIMARY_USER $DECK_BUS systemctl --user unset-environment VULKAN_ADAPTER
    sudo -u $PRIMARY_USER $DECK_BUS systemctl --user unset-environment OUTPUT_CONNECTOR
    sudo -u $PRIMARY_USER $DECK_BUS systemctl --user unset-environment PROTON_ENABLE_NVAPI
  fi
elif [[ "$OS_TYPE" == *"bazzite"* ]]; then
  if [ "$VENDOR" == "nvidia" ]; then
    echo "Stopping NVIDIA power services without disabling them for the next boot..."
    systemctl enable nvidia-powerd nvidia-persistenced 2>/dev/null || true
    systemctl stop nvidia-powerd nvidia-persistenced 2>/dev/null || true
    
    echo "Force killing any lingering GPU processes and unloading NVIDIA modules..."
    fuser -kv /dev/nvidia* >/dev/null 2>&1 || true
    modprobe -r nvidia_drm || true
    modprobe -r nvidia_modeset || true
    modprobe -r nvidia_uvm || true
    modprobe -r nvidia || true

    echo "Applying Bazzite overlay environment fixes..."
    USER_UID=$(id -u $PRIMARY_USER)
    export DECK_BUS="XDG_RUNTIME_DIR=/run/user/$USER_UID"
  
    systemctl unset-environment GAMESCOPE_DISABLE_VK_KHR_PRESENT_WAIT
    sudo -u $PRIMARY_USER $DECK_BUS systemctl --user unset-environment GAMESCOPE_DISABLE_VK_KHR_PRESENT_WAIT

  fi
fi 

# Killing every DRM card also kills the Ally session and signs Steam out.
if [[ "$OS_TYPE" != *"bazzite"* ]]; then
  echo "Ensuring card is free..."
  fuser -kv /dev/dri/card* >/dev/null 2>&1 || true
fi 
systemctl daemon-reload
# Final Reload & Restore Handheld UI
if [[ "$OS_TYPE" == "steamos" || "$OS_TYPE" == *"cachyos"* ]]; then
  USER_UID=$(id -u $PRIMARY_USER)
  export DECK_BUS="XDG_RUNTIME_DIR=/run/user/$USER_UID"
  sudo -u $PRIMARY_USER $DECK_BUS systemctl --user daemon-reload
fi

# Hardware Deactivation
INITIAL_CARDS=$(ls /dev/dri/card* 2>/dev/null)
INITIAL_COUNT=$(echo "$INITIAL_CARDS" | wc -w)

echo "Current DRM cards before disconnect: $INITIAL_COUNT"

ENABLE_PATH="/sys/devices/platform/asus-nb-wmi/egpu_enable"
echo 0 > "$ENABLE_PATH" || true
rm -f /run/xgmobile-docked
systemctl stop xgmobile-inhibit.service 2>/dev/null || true
echo "Shutdown and sleep are allowed again."
echo 1 > /sys/bus/pci/rescan

COUNT=0
SUCCESS=0

while [ $COUNT -lt 15 ]; do
  CURRENT_COUNT=$(ls /dev/dri/card* 2>/dev/null | wc -w)
  
  if [ "$CURRENT_COUNT" -lt "$INITIAL_COUNT" ]; then
    echo "Success! DRM card count dropped to $CURRENT_COUNT. eGPU safely detached."
    SUCCESS=1
    break
  fi
  
  echo "Waiting for eGPU to drop from PCIe bus... ($COUNT)"
  sleep 1
  ((COUNT++))
done

if [ "$SUCCESS" -eq 0 ]; then
  echo "WARNING: Hardware did not seem to drop from /dev/dri/. Proceeding anyway to restore UI."
fi

rm -f "/home/$PRIMARY_USER/.config/environment.d/10-xgmobile-display.conf" "/home/$PRIMARY_USER/.config/environment.d/zz-xgmobile-display.conf"
if [ -n "$DATA_DIR" ]; then
  mkdir -p "$DATA_DIR"
  echo "external" > "$DATA_DIR/display_target"
fi
echo "Cleared internal-screen Game Mode override."

# Deleting the file is not enough. The logged-in session already imported those
# values, and it keeps them after the NVIDIA driver is unloaded. Game Mode then
# waits on a GPU that is gone, so Bazzite opens Desktop instead.
if id "$PRIMARY_USER" >/dev/null 2>&1; then
  USER_UID=$(id -u "$PRIMARY_USER")
  export DECK_BUS="XDG_RUNTIME_DIR=/run/user/$USER_UID"
  SESSION_VARS="OUTPUT_CONNECTOR VULKAN_ADAPTER DXVK_FILTER_DEVICE_NAME VKD3D_FILTER_DEVICE_NAME PROTON_ENABLE_NVAPI __NV_PRIME_RENDER_OFFLOAD __GLX_VENDOR_LIBRARY_NAME __GL_SYNC_TO_VBLANK __GL_YIELD __GL_MaxFramesAllowed ADAPTIVE_SYNC STEAM_DISPLAY_REFRESH_LIMITS VKD3D_FRAME_RATE DXVK_FRAME_RATE vk_xwayland_wait_ready GAMESCOPE_DISABLE_VK_KHR_PRESENT_WAIT GAMESCOPE_WSI_HIDE_PRESENT_WAIT_EXT VKD3D_DISABLE_EXTENSIONS GAMESCOPE_WSI_ENSURE_MIN_IMAGE_COUNT GAMESCOPE_WSI_MIN_IMAGE_COUNT DXVK_CONFIG"
  systemctl unset-environment $SESSION_VARS || true
  sudo -u "$PRIMARY_USER" $DECK_BUS systemctl --user unset-environment $SESSION_VARS || true
  echo "Cleared internal-screen variables from the logged-in session."
fi

if [[ "$OS_TYPE" == *"bazzite"* ]]; then
  queue_gamescope_restart
else
  systemctl start sddm #--no-block
fi

#if [ $SUPERGFX_TRIG == 1 ]; then
#  echo "Restarting supergfxctl..."
#  systemctl restart supergfxd.service 2>/dev/null || true
#fi
#Bazzite leaves this off by default in the deck images so lets just let the user re-enable if they need to
#if command -v supergfxctl >/dev/null 2>&1; then #[[ "$OS_TYPE" == *"bazzite"* || "$OS_TYPE" == "cachyos" ]]; then
  #echo "Restarting ASUS daemon to restore Power Profile UI controls..."
  #systemctl start supergfxd.service 2>/dev/null || true
  
  #echo "Executing detached SDDM restart..."
  #( sleep 2 && systemctl restart sddm ) >/dev/null 2>&1 &
  #disown
#fi 
PRODUCT_NAME=$(cat /sys/class/dmi/id/product_name 2>/dev/null || echo "Unknown")

if command -v supergfxctl >/dev/null 2>&1; then
  if [[ "$PRODUCT_NAME" == *"RC71L"* || "$PRODUCT_NAME" == *"Ally"* ]]; then
    echo "Handheld Detected ($PRODUCT_NAME). Disabling supergfxd to prevent interference..."
    systemctl disable supergfxd.service 2>/dev/null || true
  elif [[ "$PRODUCT_NAME" == *"Flow"* || "$PRODUCT_NAME" == *"GV"* || "$PRODUCT_NAME" == *"GZ"* ]]; then
    echo "Flow Laptop Detected ($PRODUCT_NAME). Re-enabling supergfxd for MUX control just in case..."
    systemctl enable supergfxd.service 2>/dev/null || true
  else
    echo "Unknown ASUS device ($PRODUCT_NAME). Leaving supergfxd alone."
  fi
fi

echo "--- Eject Finished: Back to Handheld Mode ---"
ln -sf "$LOG_DIR/xgmobile_manager_eject_${VENDOR}.log" $LOG_DIR/xgmobile_manager_eject_latest.log
